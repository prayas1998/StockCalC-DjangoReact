{
  "name": "stockcalc-backend",
  "version": "1.0.0",
  "description": "Node.js/TypeScript backend for TradeSmart stock brokerage calculator and journal",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "echo 'Tests not configured yet'"
